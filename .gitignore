# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Secrets — NEVER commit the metering-portal cookie ─────
.env

# ── Local data — kept off GitHub ──────────────────────────
# Raw supervisor CSV + meter ids, and the DuckDB built from them via
#   python -m ingestion.run_scraper --load-sessions
# then notebook 01 writes simulation_params. The full DB also
# contains 28.7M scraped metering rows and exceeds GitHub limits.
data/
*.duckdb

# ── Reports & reference material — kept off GitHub ────────
# Dissertation PDFs, ethics form, paper library, status write-ups.
reports/

# ── Training artifacts (regenerable; results CSVs are kept) ─
policy/logs/
models/sweep/

# ── Power BI local artifacts ──────────────────────────────
# localSettings.json holds a securityBindingsSignature — a DPAPI blob encrypted
# against the local Windows account, so it is useless on any other machine.
# cache.abf is a local model cache Power BI Desktop rebuilds on open.
# editorSettings.json IS a real project setting and stays tracked.
pbi-report/**/.pbi/localSettings.json
pbi-report/**/.pbi/cache.abf

# ── Notebook / OS cruft ───────────────────────────────────
.ipynb_checkpoints/
.DS_Store
pbi-report/docs/.Rhistory
